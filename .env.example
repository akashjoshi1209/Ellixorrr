# Supabase environment variables for Ellixorrr
#
# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored — never commit real credentials.
#
# Obtain these from your Supabase project dashboard:
#   Project Settings -> API

# Public URL of your Supabase project. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Public publishable (anon) key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key. SERVER-ONLY. Never expose to the browser.
# Reserved for trusted administrative operations that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Optional public app origin used by redirect validation. Defaults to the
# request origin when unset. Do not point this at Supabase.
NEXT_PUBLIC_APP_URL=

# Optional canonical site origin used by metadata, canonical URLs,
# Open Graph, sitemap.xml, and robots.txt. Defaults to
# https://ellixorrr.dpdns.org when unset.
NEXT_PUBLIC_SITE_URL=

# Optional Google Tag Manager container ID. Analytics are skipped when unset.
NEXT_PUBLIC_GTM_ID=
